"use client";

import { useEffect, useState } from "react";
import { supabase } from "../../lib/supabase";

export default function Configuracion() {
  const [empresa, setEmpresa] = useState(null);
  const [modulos, setModulos] = useState(null);
  const [guardando, setGuardando] = useState(false);
  const [cargando, setCargando] = useState(true);

  const [form, setForm] = useState({
    nombre: "",
    telefono: "",
    correo: "",
    direccion: "",
    tipo_negocio: "",
    categoria_negocio: "",

    dias_mora_baja: 30,
    dias_mora_media: 60,
    dias_mora_alta: 90,
    dias_legal: 91,
    permite_recargo: false,
    porcentaje_recargo: 0,

    responsable_cobranza: "",
    firma_cobranza: "",
    texto_carta_mora: "",
    texto_estado_cuenta: "",

    moneda: "USD",
    zona_horaria: "America/Panama",
    permite_abonos: true,
    permite_cancelacion: true,
    metodos_pago: "Efectivo, Yappy, Transferencia, Tarjeta",
  });

  useEffect(() => {
    cargarConfiguracion();
  }, []);

  function obtenerEmpresaId() {
    const empresaId = localStorage.getItem("empresaId");

    if (!empresaId) {
      alert("No hay empresa activa.");
      window.location.href = "/login";
      return null;
    }

    return empresaId;
  }

  function volverDashboard() {
    window.location.href = "/dashboard";
  }

  function actualizarCampo(campo, valor) {
    setForm((prev) => ({
      ...prev,
      [campo]: valor,
    }));
  }

  async function cargarConfiguracion() {
    const empresaId = obtenerEmpresaId();
    if (!empresaId) return;

    setCargando(true);

    const { data: empresaData, error: errorEmpresa } = await supabase
      .from("empresas")
      .select("*")
      .eq("id", empresaId)
      .maybeSingle();

    if (errorEmpresa) {
      alert("Error cargando empresa: " + errorEmpresa.message);
      setCargando(false);
      return;
    }

    const { data: modulosData } = await supabase
      .from("empresa_modulos")
      .select("*")
      .eq("empresa_id", empresaId)
      .maybeSingle();

    setEmpresa(empresaData || null);
    setModulos(modulosData || null);

    setForm((prev) => ({
      ...prev,
      nombre: empresaData?.nombre || "",
      telefono: empresaData?.telefono || "",
      correo: empresaData?.correo || empresaData?.email || "",
      direccion: empresaData?.direccion || "",
      tipo_negocio: empresaData?.tipo_negocio || "",
      categoria_negocio: empresaData?.categoria_negocio || "",

      dias_mora_baja: empresaData?.dias_mora_baja || 30,
      dias_mora_media: empresaData?.dias_mora_media || 60,
      dias_mora_alta: empresaData?.dias_mora_alta || 90,
      dias_legal: empresaData?.dias_legal || 91,
      permite_recargo: Boolean(empresaData?.permite_recargo),
      porcentaje_recargo: empresaData?.porcentaje_recargo || 0,

      responsable_cobranza: empresaData?.responsable_cobranza || "",
      firma_cobranza: empresaData?.firma_cobranza || "",
      texto_carta_mora:
        empresaData?.texto_carta_mora ||
        "Le solicitamos realizar el pago correspondiente o comunicarse con el área de cobranza para regularizar el estado de su cuenta.",
      texto_estado_cuenta:
        empresaData?.texto_estado_cuenta ||
        "Documento generado para consulta del saldo, pagos y recargos registrados.",

      moneda: empresaData?.moneda || "USD",
      zona_horaria: empresaData?.zona_horaria || "America/Panama",
      permite_abonos:
        empresaData?.permite_abonos === undefined
          ? true
          : Boolean(empresaData?.permite_abonos),
      permite_cancelacion:
        empresaData?.permite_cancelacion === undefined
          ? true
          : Boolean(empresaData?.permite_cancelacion),
      metodos_pago:
        empresaData?.metodos_pago ||
        "Efectivo, Yappy, Transferencia, Tarjeta",
    }));

    setCargando(false);
  }

  async function guardarConfiguracion() {
    const empresaId = obtenerEmpresaId();
    if (!empresaId) return;

    if (!form.nombre.trim()) {
      alert("El nombre de la empresa es obligatorio.");
      return;
    }

    setGuardando(true);

    const { error } = await supabase
      .from("empresas")
      .update({
        nombre: form.nombre.trim(),
        telefono: form.telefono.trim(),
        correo: form.correo.trim(),
        direccion: form.direccion.trim(),
        tipo_negocio: form.tipo_negocio.trim(),
        categoria_negocio: form.categoria_negocio.trim(),

        dias_mora_baja: Number(form.dias_mora_baja || 30),
        dias_mora_media: Number(form.dias_mora_media || 60),
        dias_mora_alta: Number(form.dias_mora_alta || 90),
        dias_legal: Number(form.dias_legal || 91),
        permite_recargo: Boolean(form.permite_recargo),
        porcentaje_recargo: Number(form.porcentaje_recargo || 0),

        responsable_cobranza: form.responsable_cobranza.trim(),
        firma_cobranza: form.firma_cobranza.trim(),
        texto_carta_mora: form.texto_carta_mora.trim(),
        texto_estado_cuenta: form.texto_estado_cuenta.trim(),

        moneda: form.moneda.trim(),
        zona_horaria: form.zona_horaria.trim(),
        permite_abonos: Boolean(form.permite_abonos),
        permite_cancelacion: Boolean(form.permite_cancelacion),
        metodos_pago: form.metodos_pago.trim(),
      })
      .eq("id", empresaId);

    setGuardando(false);

    if (error) {
      alert("Error guardando configuración: " + error.message);
      return;
    }

    localStorage.setItem("empresaNombre", form.nombre.trim());

    alert("Configuración guardada correctamente.");
    await cargarConfiguracion();
  }

  function nombreModulo(key) {
    const nombres = {
      clientes: "Clientes",
      vista_cliente: "Vista Cliente",
      venta_credito: "Créditos",
      caja: "Caja",
      control_caja: "Control Caja",
      cobranza: "Cobranza",
      dashboard_cobros: "Centro de Cobranza",
      inventario: "Inventario",
      dashboard_ventas: "Centro de Ventas",
      suscripciones: "Suscripciones",
      recargos: "Recargos",
      egresos: "Gastos",
    };

    return nombres[key] || key.replaceAll("_", " ");
  }

  const modulosVisibles = modulos
    ? Object.keys(modulos).filter(
        (key) =>
          !["id", "empresa_id", "created_at", "updated_at"].includes(key) &&
          typeof modulos[key] === "boolean"
      )
    : [];

  if (cargando) {
    return <div style={{ padding: "30px" }}>Cargando configuración...</div>;
  }

  return (
    <div style={pagina}>
      <div style={contenedor}>
        <div style={hero}>
          <div>
            <h1 style={tituloHero}>Configuración</h1>
            <p style={subtituloHero}>
              Parámetros generales de la empresa, cobranza, caja y documentos.
            </p>
          </div>

          <button style={botonClaro} onClick={volverDashboard}>
            ← Volver al Dashboard
          </button>
        </div>

        <div style={card}>
          <h2 style={tituloSeccion}>Datos de la empresa</h2>

          <div style={grid}>
            <Campo label="Nombre comercial">
              <input
                value={form.nombre}
                onChange={(e) => actualizarCampo("nombre", e.target.value)}
                style={inputStyle}
              />
            </Campo>

            <Campo label="Teléfono">
              <input
                value={form.telefono}
                onChange={(e) => actualizarCampo("telefono", e.target.value)}
                style={inputStyle}
              />
            </Campo>

            <Campo label="Correo">
              <input
                value={form.correo}
                onChange={(e) => actualizarCampo("correo", e.target.value)}
                style={inputStyle}
              />
            </Campo>

            <Campo label="Tipo de negocio">
              <input
                value={form.tipo_negocio}
                onChange={(e) =>
                  actualizarCampo("tipo_negocio", e.target.value)
                }
                style={inputStyle}
              />
            </Campo>

            <Campo label="Categoría">
              <input
                value={form.categoria_negocio}
                onChange={(e) =>
                  actualizarCampo("categoria_negocio", e.target.value)
                }
                style={inputStyle}
              />
            </Campo>
          </div>

          <Campo label="Dirección">
            <textarea
              value={form.direccion}
              onChange={(e) => actualizarCampo("direccion", e.target.value)}
              style={textarea}
            />
          </Campo>
        </div>

        <div style={card}>
          <h2 style={tituloSeccion}>Reglas de cobranza</h2>

          <div style={grid}>
            <Campo label="Mora baja hasta días">
              <input
                type="number"
                value={form.dias_mora_baja}
                onChange={(e) =>
                  actualizarCampo("dias_mora_baja", e.target.value)
                }
                style={inputStyle}
              />
            </Campo>

            <Campo label="Mora media hasta días">
              <input
                type="number"
                value={form.dias_mora_media}
                onChange={(e) =>
                  actualizarCampo("dias_mora_media", e.target.value)
                }
                style={inputStyle}
              />
            </Campo>

            <Campo label="Mora alta hasta días">
              <input
                type="number"
                value={form.dias_mora_alta}
                onChange={(e) =>
                  actualizarCampo("dias_mora_alta", e.target.value)
                }
                style={inputStyle}
              />
            </Campo>

            <Campo label="Pasar a legal desde días">
              <input
                type="number"
                value={form.dias_legal}
                onChange={(e) => actualizarCampo("dias_legal", e.target.value)}
                style={inputStyle}
              />
            </Campo>

            <Campo label="Permite recargo">
              <select
                value={form.permite_recargo ? "Sí" : "No"}
                onChange={(e) =>
                  actualizarCampo("permite_recargo", e.target.value === "Sí")
                }
                style={inputStyle}
              >
                <option>Sí</option>
                <option>No</option>
              </select>
            </Campo>

            <Campo label="% Recargo">
              <input
                type="number"
                value={form.porcentaje_recargo}
                onChange={(e) =>
                  actualizarCampo("porcentaje_recargo", e.target.value)
                }
                style={inputStyle}
              />
            </Campo>
          </div>
        </div>

        <div style={card}>
          <h2 style={tituloSeccion}>Documentos y cobranza</h2>

          <div style={grid}>
            <Campo label="Responsable de cobranza">
              <input
                value={form.responsable_cobranza}
                onChange={(e) =>
                  actualizarCampo("responsable_cobranza", e.target.value)
                }
                style={inputStyle}
              />
            </Campo>

            <Campo label="Firma / Departamento">
              <input
                value={form.firma_cobranza}
                onChange={(e) =>
                  actualizarCampo("firma_cobranza", e.target.value)
                }
                style={inputStyle}
              />
            </Campo>
          </div>

          <Campo label="Texto base para carta de mora">
            <textarea
              value={form.texto_carta_mora}
              onChange={(e) =>
                actualizarCampo("texto_carta_mora", e.target.value)
              }
              style={textarea}
            />
          </Campo>

          <Campo label="Texto base para estado de cuenta">
            <textarea
              value={form.texto_estado_cuenta}
              onChange={(e) =>
                actualizarCampo("texto_estado_cuenta", e.target.value)
              }
              style={textarea}
            />
          </Campo>
        </div>

        <div style={card}>
          <h2 style={tituloSeccion}>Caja y pagos</h2>

          <div style={grid}>
            <Campo label="Moneda">
              <input
                value={form.moneda}
                onChange={(e) => actualizarCampo("moneda", e.target.value)}
                style={inputStyle}
              />
            </Campo>

            <Campo label="Zona horaria">
              <input
                value={form.zona_horaria}
                onChange={(e) =>
                  actualizarCampo("zona_horaria", e.target.value)
                }
                style={inputStyle}
              />
            </Campo>

            <Campo label="Permite abonos">
              <select
                value={form.permite_abonos ? "Sí" : "No"}
                onChange={(e) =>
                  actualizarCampo("permite_abonos", e.target.value === "Sí")
                }
                style={inputStyle}
              >
                <option>Sí</option>
                <option>No</option>
              </select>
            </Campo>

            <Campo label="Permite cancelación total">
              <select
                value={form.permite_cancelacion ? "Sí" : "No"}
                onChange={(e) =>
                  actualizarCampo(
                    "permite_cancelacion",
                    e.target.value === "Sí"
                  )
                }
                style={inputStyle}
              >
                <option>Sí</option>
                <option>No</option>
              </select>
            </Campo>
          </div>

          <Campo label="Métodos de pago permitidos">
            <input
              value={form.metodos_pago}
              onChange={(e) => actualizarCampo("metodos_pago", e.target.value)}
              style={inputStyle}
            />
          </Campo>
        </div>

        <div style={card}>
          <h2 style={tituloSeccion}>Plan y módulos activos</h2>
          <p style={ayuda}>
            Esta sección es solo informativa. Los módulos del plan no se editan
            desde la empresa.
          </p>

          <div style={modulosGrid}>
            {modulosVisibles.map((key) => (
              <div key={key} style={moduloItem}>
                <span>{nombreModulo(key)}</span>
                <strong style={modulos[key] ? activo : inactivo}>
                  {modulos[key] ? "Activo" : "Inactivo"}
                </strong>
              </div>
            ))}

            {modulosVisibles.length === 0 && (
              <p>No hay módulos configurados para esta empresa.</p>
            )}
          </div>
        </div>

        <div style={acciones}>
          <button style={botonGuardar} onClick={guardarConfiguracion}>
            {guardando ? "Guardando..." : "Guardar Configuración"}
          </button>

          <button style={botonGris} onClick={cargarConfiguracion}>
            Recargar
          </button>
        </div>
      </div>
    </div>
  );
}

function Campo({ label, children }) {
  return (
    <div>
      <label style={labelStyle}>{label}</label>
      {children}
    </div>
  );
}

const pagina = {
  minHeight: "100vh",
  background: "#eef2f7",
  padding: "24px",
  fontFamily: "Arial, sans-serif",
};

const contenedor = {
  maxWidth: "1400px",
  margin: "0 auto",
};

const hero = {
  background: "linear-gradient(135deg, #111827, #064e3b)",
  color: "#ffffff",
  padding: "26px",
  borderRadius: "22px",
  marginBottom: "18px",
  display: "flex",
  justifyContent: "space-between",
  alignItems: "center",
  gap: "16px",
  flexWrap: "wrap",
};

const tituloHero = {
  margin: 0,
  fontSize: "36px",
};

const subtituloHero = {
  color: "#dcfce7",
  marginTop: "8px",
};

const card = {
  background: "#ffffff",
  padding: "22px",
  borderRadius: "18px",
  marginBottom: "16px",
  boxShadow: "0 3px 12px rgba(0,0,0,0.06)",
  border: "1px solid #e5e7eb",
};

const tituloSeccion = {
  marginTop: 0,
  color: "#111827",
};

const ayuda = {
  color: "#6b7280",
  fontSize: "14px",
};

const grid = {
  display: "grid",
  gridTemplateColumns: "repeat(auto-fit,minmax(240px,1fr))",
  gap: "14px",
};

const labelStyle = {
  display: "block",
  marginBottom: "6px",
  fontWeight: "bold",
  color: "#374151",
  fontSize: "13px",
};

const inputStyle = {
  width: "100%",
  padding: "12px",
  borderRadius: "10px",
  border: "1px solid #d1d5db",
  boxSizing: "border-box",
  background: "#ffffff",
  color: "#111827",
  fontSize: "14px",
};

const textarea = {
  ...inputStyle,
  minHeight: "90px",
  resize: "vertical",
};

const acciones = {
  display: "flex",
  gap: "12px",
  flexWrap: "wrap",
  marginBottom: "30px",
};

const botonGuardar = {
  background: "#16a34a",
  color: "#ffffff",
  border: "none",
  padding: "14px 24px",
  borderRadius: "10px",
  fontWeight: "bold",
  cursor: "pointer",
};

const botonGris = {
  background: "#6b7280",
  color: "#ffffff",
  border: "none",
  padding: "14px 24px",
  borderRadius: "10px",
  fontWeight: "bold",
  cursor: "pointer",
};

const botonClaro = {
  background: "#ffffff",
  color: "#111827",
  border: "none",
  padding: "12px 20px",
  borderRadius: "10px",
  fontWeight: "bold",
  cursor: "pointer",
};

const modulosGrid = {
  display: "grid",
  gridTemplateColumns: "repeat(auto-fit,minmax(220px,1fr))",
  gap: "12px",
};

const moduloItem = {
  background: "#f9fafb",
  padding: "14px",
  borderRadius: "12px",
  border: "1px solid #e5e7eb",
  display: "flex",
  justifyContent: "space-between",
  gap: "10px",
};

const activo = {
  color: "#166534",
};

const inactivo = {
  color: "#991b1b",
};
